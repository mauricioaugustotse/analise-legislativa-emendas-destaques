# A CLI lê variáveis de ambiente (não carrega este arquivo sozinha). Exemplo no bash: set -a; . ./.env; set +a

# Serviço de análise na rede interna (docs/04-analise-semantica.md).
ANALYZER_URL=http://localhost:8080/analyze
ANALYZER_TOKEN=

# Executável do Tesseract quando ele não está no PATH (instalação padrão no Windows).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Analisador de referência (examples/analisador_referencia.py): modelo compatível com Chat Completions.
LLM_BASE_URL=http://llm.interno.exemplo/v1
LLM_MODEL=
LLM_API_KEY=
# LLM_EXTRA_JSON={"temperature": 0}
